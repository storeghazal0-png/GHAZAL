# ==============================================================================
# GHAZAL COSMETICS & MORE — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env.local for local development.
# Configure all variables below in your Vercel Project Settings > Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon)
# ------------------------------------------------------------------------------
# Connect to Postgres via transaction-mode pooler (port 6543, pgbouncer=true) for serverless queries
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres directly / session-mode pooler (port 5432) for Prisma migrations and schema pushes
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional: Maximum database connection pool size per serverless instance (default: 10)
DB_POOL_MAX="10"

# ------------------------------------------------------------------------------
# 2. SUPABASE PLATFORM CONFIGURATION (Auth & Storage)
# ------------------------------------------------------------------------------
# Public Supabase URL (used in browser client and server)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# Supabase Anon / Publishable Key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Secret Key (NEVER expose to client, used for server-side admin/storage)
SUPABASE_SECRET_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optional fallback server environment variables
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_JWKS_URL="https://[PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json"

# ------------------------------------------------------------------------------
# 3. DISASTER RECOVERY & BACKUP SYSTEM (Neon Independent Standby)
# ------------------------------------------------------------------------------
# Independent Neon PostgreSQL DR database URL (strictly isolated from daily Prisma traffic)
NEON_BACKUP_URL="postgresql://neondb_owner:[NEON-PASSWORD]@[NEON-ENDPOINT].c-10.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Supabase source database URL for automated pg_dump / backup extract
SUPABASE_BACKUP_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Automated DR status notification email recipients
BACKUP_EMAIL_TO="admin@example.com"
BACKUP_EMAIL_FROM="notifications@example.com"

# ------------------------------------------------------------------------------
# 4. APPLICATION BRANDING, LOCALIZATION & CONTACTS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="GHAZAL Cosmetics & More"
NEXT_PUBLIC_APP_URL="https://ghazal.jo"
PUBLIC_APP_URL="https://ghazal.jo"

# WhatsApp customer care link (country code + number, e.g. 962799991234)
NEXT_PUBLIC_WHATSAPP_NUMBER="962799991234"
NEXT_PUBLIC_STORE_CITY="Amman, Jordan"

# Jordan Currency & Precision (JOD / Fils - 3 decimal places)
NEXT_PUBLIC_CURRENCY_CODE="JOD"
NEXT_PUBLIC_CURRENCY_SYMBOL="د.أ"

# ------------------------------------------------------------------------------
# 5. SECURITY & SESSION MANAGEMENT
# ------------------------------------------------------------------------------
# 64+ char random secret key for HMAC session signing and POS authentication
SESSION_SECRET="generate_a_random_64_character_hex_or_base64_string_here"

# ------------------------------------------------------------------------------
# 6. SCHEDULED JOBS & VERCEL CRON INTEGRATION
# ------------------------------------------------------------------------------
# Bearer token to protect cron endpoints (e.g., /api/cron/cleanup-orders)
CRON_SECRET="generate_a_secure_random_cron_token_here"

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAILS (Resend)
# ------------------------------------------------------------------------------
# Resend API Key for order and backup notification emails
RESEND_API_KEY="re_1234567890abcdef"
RESEND_FROM_EMAIL="notifications@example.com"
RESEND_ORDER_NOTIFICATION_EMAIL="admin@example.com"

# ------------------------------------------------------------------------------
# 8. TEST & CI RUNTIME OVERRIDES (Optional)
# ------------------------------------------------------------------------------
# Dedicated test database for automated Vitest test runs
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ghazal_test?sslmode=disable"
