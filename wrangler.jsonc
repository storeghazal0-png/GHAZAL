{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghazal-1",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "54b9a6b656924e5898c441fe1ec40b08"
    }
  ],
  "placement": {
    "region": "aws:eu-central-1"
  }
}
